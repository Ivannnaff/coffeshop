APP_NAME="Menanti Pagi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://menanti.example.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database PostgreSQL (Supabase atau PostgreSQL terkelola)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Storage gambar produk (Supabase Storage S3-compatible)
FILESYSTEM_DISK=supabase
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET=menanti-products
SUPABASE_PUBLIC_URL=

# Queue, cache, session
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=menanti.example.com
SESSION_SECURE_COOKIE=true

# Pembayaran Midtrans PRODUKSI
PAYMENT_GATEWAY=midtrans
PAYMENT_FINISH_URL=https://menanti.example.com/
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_SECRET_KEY=
MIDTRANS_IS_PRODUCTION=true
PAYMENT_EXPIRY_MINUTES=15

# Broadcast: pakai "log" jika Reverb belum dijalankan (UI memakai polling).
# Ganti ke "reverb" dan isi kredensial di bawah bila Reverb aktif.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_PUBLIC_URL=

# Maps (jarak antar memakai haversine; API key opsional)
MAPS_PROVIDER=haversine
GOOGLE_MAPS_API_KEY=

# Frontend
MENU_URL=/
VITE_APP_NAME="Menanti Pagi"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

# Monitoring
SENTRY_LARAVEL_DSN=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@menanti.example.com"
MAIL_FROM_NAME="${APP_NAME}"
